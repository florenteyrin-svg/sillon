<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup "Widget vinyle": a big record coming out of a card, S tonearm, card with title, logo, spectrum, buttons -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">

  <FrameLayout android:id="@+id/w_disc" android:layout_width="170dp" android:layout_height="170dp"
      android:layout_gravity="top|start" android:layout_marginStart="6dp">
    <ImageView android:id="@+id/w_still" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/vinyl_disc"/>
    <ProgressBar android:id="@+id/w_spin" android:layout_width="match_parent" android:layout_height="match_parent"
        android:indeterminate="true" android:indeterminateDrawable="@drawable/vinyl_spin" android:indeterminateDuration="1800"/>
    <ImageView android:id="@+id/w_cover" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"/>
  </FrameLayout>

  <ImageView android:layout_width="70dp" android:layout_height="130dp" android:layout_gravity="top|start"
      android:layout_marginStart="138dp" android:layout_marginTop="-8dp" android:src="@drawable/tonearm"/>

  <FrameLayout android:layout_width="match_parent" android:layout_height="128dp" android:layout_gravity="bottom"
      android:background="@drawable/widget_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="50dp" android:layout_gravity="bottom"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:scaleType="fitXY" android:src="@drawable/spectrum"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="10dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
          <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:textColor="#FFC4C4CC" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/w_quality" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/badge_bg" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="#FF2A1E00" android:textSize="11sp" android:textStyle="bold"/>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
          android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_album" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/pill_bg"
            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Album"
            android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/w_prev" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/ic_w_prev" android:contentDescription="Précédent"/>
        <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/ic_w_play" android:contentDescription="Lecture"/>
        <ImageButton android:id="@+id/w_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/ic_w_next" android:contentDescription="Suivant"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/w_artist_btn" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/pill_bg"
            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Artiste"
            android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"/>
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
