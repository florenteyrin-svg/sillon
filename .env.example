# ---- Required ----
# Your music folder (the same one à la carte writes into)
MUSIC_PATH=/media/Stockage/Mes Musiques

# ---- Where settings and databases are kept ----
SILLON_DATA_PATH=/DATA/AppData/sillon
# Songs listened to from the search without downloading them: kept here, outside the music folder
SILLON_CACHE_PATH=/DATA/AppData/sillon/cache
SILLON_CACHE_MAX_GB=10
# The data folder of your current à la carte (it holds web/, wrapper/ and supervisor/):
# reusing it keeps your Apple sign-in, account and settings.
ALACARTE_DATA_PATH=/DATA/AppData/alacarte/data

# ---- Sillon account (created on first start; used by the apps and Music Assistant) ----
SILLON_ADMIN_USER=admin
SILLON_ADMIN_PASSWORD=change-me

# ---- Your à la carte account (the one you sign in with on http://SERVER:7373) ----
ALACARTE_USER=
ALACARTE_PASSWORD=

# ---- Docker network: share reseau-media with Allstarr / Jellyfin ----
DOCKER_NETWORK=reseau-media
DOCKER_NETWORK_EXTERNAL=true

# ---- à la carte options (your version) ----
# Days before unkept discoveries are deleted (0 = never)
AMDL_DISCOVERY_DAYS=30
# Animated covers (1 = on, 0 = off)
AMDL_ANIMATED_ARTWORK=1
AMDL_CLIPS_FOLDER=Mes Clips

# ---- Optional ----
# Owner of downloaded files and of the data folders (output of `id -u` / `id -g`). Unset = root.
# PUID=1000
# PGID=1000
SILLON_PORT=4747
ALACARTE_PORT=7373
TZ=Europe/Paris
