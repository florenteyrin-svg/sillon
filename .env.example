# ---- Required ----
# Your music folder on the server (the same one à la carte writes into)
MUSIC_PATH=/DATA/Media/Music

# ---- Where settings and databases are kept (absolute paths recommended on ZimaOS) ----
SILLON_DATA_PATH=/DATA/AppData/sillon
ALACARTE_DATA_PATH=/DATA/AppData/alacarte

# ---- Sillon account (created on first start; then used by the apps and Music Assistant) ----
SILLON_ADMIN_USER=admin
SILLON_ADMIN_PASSWORD=change-me

# ---- à la carte account (the one you create on its page at http://SERVER:7373) ----
ALACARTE_USER=
ALACARTE_PASSWORD=

# ---- Optional ----
# Owner of downloaded files and of the data folders (output of `id -u` / `id -g`). Unset = root.
# PUID=1000
# PGID=1000
SILLON_PORT=4747
ALACARTE_PORT=7373
TZ=Europe/Paris
